# Server
PORT=3000
# Public site URL (no trailing slash). On Netlify: https://your-site.netlify.app
BASE_URL=http://localhost:3000

# Supabase (Project Settings ? API)
# URL can also be set as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=https://your-project.supabase.co

# Secret key � service_role JWT (eyJ...) or sb_secret_... � NOT publishable/anon
# CORRECT: paste only the key value after the equals sign:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# WRONG: do not repeat the variable name in the value:
# SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias for newer Supabase secret keys:
# SUPABASE_SECRET_KEY=sb_secret_...

# Storage bucket name (create via supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=pdfs

# Public anon key for Admin portal (Supabase Auth) + Edge Function apikey header
SUPABASE_ANON_KEY=your-anon-key

# Used by links-create / view-resolve / portal config
PUBLIC_BASE_URL=http://localhost:3000

# First admin bootstrap at /admin/ (must match the secret typed in the UI)
BOOTSTRAP_SECRET=change-me-to-a-long-random-string

