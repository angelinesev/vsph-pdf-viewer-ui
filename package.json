{
  "name": "pdf-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "PDF flip-book viewer with Supabase-backed client links",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "dev:local": "LOCAL_UI_MODE=true node server/index.js",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:all": "node scripts/write-portal-config.js && npm run build:ui && npm run build:admin && npm run check:browser-build",
    "setup:supabase": "node scripts/setup-supabase.js",
    "migrate:view-type": "node scripts/migrate-view-type.js",
    "migrate:tenancy": "node scripts/migrate-legacy-to-tenancy.js",
    "validate:env": "node scripts/validate-env.js",
    "write:config": "node scripts/write-portal-config.js",
    "check:browser-build": "node scripts/check-browser-build.js",
    "reset:admin": "node scripts/reset-admin.js",
    "apply:vsph-plan": "node scripts/apply-vsph-plan.js",
    "apply:projects": "node scripts/apply-projects-analytics.js",
    "verify:netlify": "node scripts/verify-netlify.js",
    "deploy:netlify": "netlify deploy --prod",
    "test:e2e": "node scripts/e2e-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^7.29.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "netlify-cli": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
